# URL base da API real (usada só quando VITE_USE_MOCKS=false).
# Perfil "http" do backend em Backend/Financeiro.Api/Properties/launchSettings.json.
VITE_API_URL=http://localhost:5027/api

# true  = as chamadas de API são interceptadas pelo MSW (Mock Service Worker) e
#         respondidas com dados fixos em memória — dá pra usar o front-end
#         inteiro sem o backend/banco rodando.
# false = as chamadas vão de verdade para VITE_API_URL (backend precisa estar
#         rodando, com o banco populado).
VITE_USE_MOCKS=false
